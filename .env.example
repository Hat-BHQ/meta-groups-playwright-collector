PORT=3001

# Dedicated Facebook session for Meta Groups. Do not symlink the Marketplace state.
GROUPS_STORAGE_STATE=/app/data/groups-storageState.json

# Keep one collector at a time initially. Raise to 2 only after stable monitoring.
GROUPS_MAX_CONCURRENT=1

GROUPS_HEADLESS=true
GROUPS_LOCALE=vi-VN
GROUPS_TIMEZONE=Asia/Ho_Chi_Minh
GROUPS_ACCEPT_LANGUAGE=vi-VN,vi;q=0.9,en-US;q=0.8,en;q=0.7

GROUPS_NAVIGATION_TIMEOUT_MS=90000
GROUPS_ACTION_TIMEOUT_MS=30000
GROUPS_LINK_VERIFY_TIMEOUT_MS=30000

GROUPS_MAX_POSTS_PER_RUN=300
GROUPS_MIN_SCROLLS=8
GROUPS_MAX_SCROLLS=30
GROUPS_SCROLL_DELAY_MIN_MS=1200
GROUPS_SCROLL_DELAY_MAX_MS=2500
GROUPS_STABLE_SCROLL_ROUNDS=3
GROUPS_LINK_VERIFY_LIMIT=40
GROUPS_INITIAL_WAIT_MS=3500
